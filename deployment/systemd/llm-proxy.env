# LLM Proxy Environment Configuration
# Copy this file to /etc/default/llm-proxy and customize

# Server Configuration
LLM_PROXY_SERVER_HOST=0.0.0.0
LLM_PROXY_SERVER_PORT=8080
LLM_PROXY_SERVER_TLS_PORT=8443
LLM_PROXY_SERVER_ENABLE_TLS=true
LLM_PROXY_SERVER_TLS_CERT=/etc/ssl/certs/llm-proxy.crt
LLM_PROXY_SERVER_TLS_KEY=/etc/ssl/private/llm-proxy.key

# Security Configuration
LLM_PROXY_SECURITY_SESSION_SECRET=your-secret-key-change-me
LLM_PROXY_SECURITY_SESSION_TIMEOUT=24h
LLM_PROXY_SECURITY_RATE_LIMIT=1000
LLM_PROXY_SECURITY_ENABLE_CORS=false
LLM_PROXY_SECURITY_CORS_ALLOWED_ORIGINS=https://example.com

# Proxy Configuration
LLM_PROXY_PROXY_TIMEOUT=30
LLM_PROXY_PROXY_MAX_RETRIES=3
LLM_PROXY_PROXY_REQUEST_TIMEOUT=60
LLM_PROXY_PROXY_IDLE_TIMEOUT=90

# Logging Configuration
LLM_PROXY_LOGGING_LEVEL=info
LLM_PROXY_LOGGING_FORMAT=json
LLM_PROXY_LOGGING_FILE=/var/log/llm-proxy/app.log
LLM_PROXY_LOGGING_ENABLE_AUDIT=true

# Metrics Configuration
LLM_PROXY_MONITORING_ENABLED=true
LLM_PROXY_MONITORING_METRICS_PORT=9090

# Performance Configuration
LLM_PROXY_PERFORMANCE_CONNECTION_POOL_SIZE=100
LLM_PROXY_PERFORMANCE_CACHE_ENABLED=true
LLM_PROXY_PERFORMANCE_CACHE_TTL=300
LLM_PROXY_PERFORMANCE_ENABLE_COMPRESSION=true

# Data Directories
LLM_PROXY_DATA_DIR=/opt/llm-proxy/data
LLM_PROXY_CONFIG_DIR=/opt/llm-proxy/config
LLM_PROXY_LOG_DIR=/var/log/llm-proxy
