# LLM Proxy Environment Configuration

# Server Configuration
LLM_PROXY_SERVER_PORT=8080
LLM_PROXY_SERVER_TLS_PORT=8443
LLM_PROXY_SERVER_ENABLE_TLS=true
LLM_PROXY_SERVER_ENABLE_HTTP2=true
LLM_PROXY_SERVER_ENABLE_CORS=true
LLM_PROXY_SERVER_CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# TLS Configuration
LLM_PROXY_SERVER_TLS_CERT_PATH=/app/data/tls/cert.pem
LLM_PROXY_SERVER_TLS_KEY_PATH=/app/data/tls/key.pem

# Security Configuration
LLM_PROXY_SECURITY_SESSION_SECRET=change-this-to-a-random-secret-key
LLM_PROXY_SECURITY_PASSWORD_ALGORITHM=argon2id
LLM_PROXY_SECURITY_PASSWORD_MEMORY=65536
LLM_PROXY_SECURITY_PASSWORD_ITERATIONS=3
LLM_PROXY_SECURITY_PASSWORD_PARALLELISM=1
LLM_PROXY_SECURITY_CSRF_ENABLED=true

# Rate Limiting
LLM_PROXY_SERVER_RATE_LIMIT_ENABLED=true
LLM_PROXY_SERVER_RATE_LIMIT_RATE=1000
LLM_PROXY_SERVER_RATE_LIMIT_BURST=100
LLM_PROXY_SERVER_RATE_LIMIT_PER_IP=true

# Proxy Configuration
LLM_PROXY_PROXY_ENABLED=true
LLM_PROXY_PROXY_TIMEOUT=30
LLM_PROXY_PROXY_MAX_RETRIES=3
LLM_PROXY_PROXY_RETRY_DELAY=1

# Provider Configuration (OpenAI example)
# LLM_PROXY_PROXY_PROVIDERS_0__ID=openai
# LLM_PROXY_PROXY_PROVIDERS_0__NAME=OpenAI
# LLM_PROXY_PROXY_PROVIDERS_0__APIURL=https://api.openai.com/v1
# LLM_PROXY_PROXY_PROVIDERS_0__APIKEY=your-openai-api-key
# LLM_PROXY_PROXY_PROVIDERS_0__ENABLED=true
# LLM_PROXY_PROXY_PROVIDERS_0__PRIORITY=100

# Logging Configuration
LLM_PROXY_LOGGING_LEVEL=info
LLM_PROXY_LOGGING_FORMAT=json
LLM_PROXY_LOGGING_OUTPUT=file
LLM_PROXY_LOGGING_FILE_PATH=/app/logs/app.log
LLM_PROXY_LOGGING_MAX_SIZE=100
LLM_PROXY_LOGGING_MAX_BACKUPS=10
LLM_PROXY_LOGGING_MAX_AGE=30
LLM_PROXY_LOGGING_COMPRESS=true

# Audit Logging
LLM_PROXY_LOGGING_AUDIT_ENABLED=true
LLM_PROXY_LOGGING_AUDIT_FILE_PATH=/app/logs/audit.log
LLM_PROXY_LOGGING_AUDIT_RETENTION=720h
LLM_PROXY_LOGGING_AUDIT_MAX_SIZE=100
LLM_PROXY_LOGGING_AUDIT_MAX_BACKUPS=30
LLM_PROXY_LOGGING_AUDIT_COMPRESS=true

# Storage Configuration
LLM_PROXY_STORAGE_CONFIG_PATH=/app/data/config
LLM_PROXY_STORAGE_BACKUP_PATH=/app/data/backup
LLM_PROXY_STORAGE_AUTO_BACKUP=true
LLM_PROXY_STORAGE_BACKUP_INTERVAL=3600

# Monitoring Configuration
LLM_PROXY_MONITORING_ENABLED=true
LLM_PROXY_MONITORING_PATH=/metrics
LLM_PROXY_MONITORING_PREFIX=llm_proxy
LLM_PROXY_MONITORING_METRICS_ENABLED=true
LLM_PROXY_MONITORING_METRICS_PATH=/metrics
LLM_PROXY_MONITORING_HEALTH_CHECKS_ENABLED=true
LLM_PROXY_MONITORING_HEALTH_CHECKS_BASIC_PATH=/healthz
LLM_PROXY_MONITORING_HEALTH_CHECKS_DETAILED_PATH=/healthz/detailed
